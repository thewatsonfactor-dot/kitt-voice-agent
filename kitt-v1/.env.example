# KITT — local-first voice operating system
# Copy to .env and fill in. Never commit .env.

# ----- Anthropic (cloud reasoning) -----
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_TIMEOUT_MS=8000

# ----- Ollama (local routing + fallback) -----
OLLAMA_URL=http://localhost:11434
OLLAMA_ROUTER_MODEL=qwen2.5:7b
OLLAMA_FALLBACK_MODEL=qwen2.5:7b
OLLAMA_ROUTER_TIMEOUT_MS=600

# ----- Audio -----
# macOS `say` voice. "Daniel" = British male (KITT-adjacent).
# "Alex" is closer to the actual William Daniels cadence — try both.
TTS_VOICE=Daniel
TTS_RATE=185

# ----- Whisper (Python sidecar) -----
# Model size: tiny.en | base.en | small.en | medium.en
# small.en is the right default on a 38GB Mac Mini.
WHISPER_MODEL=small.en
WHISPER_DEVICE=auto

# ----- Hotword -----
# Phrase the rolling transcriber listens for to wake KITT.
HOTWORD_PHRASE=hey kitt

# ----- Server -----
PORT=7878

# ----- Cost guardrails -----
# Hard daily Claude spend cap in USD. Server refuses cloud calls past this.
DAILY_COST_CAP_USD=2.00
