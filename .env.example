# =====================================================================
# Watson JARVIS — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =====================================================================

# ---------------------------------------------------------------------
# Anthropic (Claude) — required
# Get from: https://console.anthropic.com/settings/keys
# Use a NEW key dedicated to JARVIS so you can revoke it separately
# from Claude Code and your existing Watson Agent.
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Models — these are the strings the SDK expects.
ANTHROPIC_MODEL_REASONING=claude-sonnet-4-6
ANTHROPIC_MODEL_ROUTER=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------
# Picovoice (hotword detection) — required
# Get free access key from: https://console.picovoice.ai
# Free tier covers personal use.
# ---------------------------------------------------------------------
PICOVOICE_ACCESS_KEY=

# Path to a custom .ppn keyword file. Leave blank for MVP to use the
# built-in "Computer" wake word. Generate a "Watson" .ppn at the
# Picovoice console and drop it under ./assets/wakewords/watson.ppn
PORCUPINE_KEYWORD_PATH=

# ---------------------------------------------------------------------
# ElevenLabs (TTS) — required
# Get from: https://elevenlabs.io/app/settings/api-keys
# ---------------------------------------------------------------------
ELEVENLABS_API_KEY=

# Voice ID — pick one from https://elevenlabs.io/app/voice-library
# "Adam" is a solid default butler voice. Replace with a cloned voice later.
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Streaming latency optimization — 0 (default) to 4 (lowest latency, lower quality)
ELEVENLABS_LATENCY=2

# ---------------------------------------------------------------------
# Whisper (local STT) — no API key needed
# ---------------------------------------------------------------------
# Model size: tiny.en | base.en | small.en | medium.en
# Start with small.en. Bump to medium.en if word error rate is too high.
WHISPER_MODEL=small.en

# ---------------------------------------------------------------------
# Audio capture tuning
# ---------------------------------------------------------------------
# RMS threshold below which audio counts as silence (0.0 - 1.0)
SILENCE_THRESHOLD=0.02
# Milliseconds of continuous silence before recording ends
SILENCE_MS=1000
# Hard cap on a single utterance, milliseconds
MAX_UTTERANCE_MS=15000

# ---------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------
PORT=7878

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------
LOG_LEVEL=info
# Set to 1 to write every Claude request/response to ~/.watson/logs/
LOG_TO_DISK=0
